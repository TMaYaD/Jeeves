#!/bin/sh

# Redirect output to stderr.
exec 1>&2

echo 'Running pre-commit hooks...'

# Check if backend files changed
if git diff --cached --name-only | grep -q "^backend/"; then
    echo "=> 🐍 Backend files modified. Running checks..."
    
    cd backend || exit 1

    # backend/.venv is gitignored and only materialized by `uv sync`, so a
    # freshly created linked worktree does not have one. Check before sourcing,
    # because the failure mode of a bare `. .venv/bin/activate` is
    # interpreter-dependent. In POSIX mode — dash, or the /bin/sh this hook's
    # shebang selects when git runs it — `.` is a special builtin, so a failed
    # source exits the script: cryptic, but it does stop. Under zsh (and plain
    # bash) the same failure is NON-FATAL, so execution falls through to
    # whichever unactivated ruff/mypy/pytest sits on the outer PATH; those
    # "pass" against the wrong environment and the hook reaches `exit 0`, which
    # tells git to go ahead and commit with the checks never having run.
    # Assert the prerequisite explicitly instead (#539).
    if [ ! -f .venv/bin/activate ]; then
        echo "❌ No backend venv found at backend/.venv (needed for ruff/mypy/pytest)."
        echo "   Run 'cd backend && uv sync --extra dev' and retry."
        exit 1
    fi

    # Existence is not activation, and the gap between them is #539 all over
    # again: everything below the guard above can still fall through to the
    # outer PATH. Three distinct ways that happens, so three checks.

    # 1. Present but unreadable (bad mode bits). Under POSIX sh the failed `.`
    #    would abort with only the shell's own error; everywhere else it is
    #    non-fatal and falls through. Catch it here so every interpreter gets
    #    the same actionable message.
    if [ ! -r .venv/bin/activate ]; then
        echo "❌ backend/.venv exists but backend/.venv/bin/activate is not readable."
        echo "   The venv is present but unusable."
        echo "   Re-create it: 'cd backend && rm -rf .venv && uv sync --extra dev'."
        exit 1
    fi

    # 2. Readable but not sourceable (corrupt/half-written activate). Probe in a
    #    SUBSHELL rather than sourcing directly: in dash — /bin/sh on most
    #    Linux, so the interpreter git actually uses there — a parse error in a
    #    sourced file is fatal, and would kill the hook before it could report
    #    anything. A subshell contains that death and turns it into a status we
    #    can act on, in every interpreter. (Don't expect this to reproduce on
    #    macOS: /bin/sh there is bash in POSIX mode, which is fatal for a failed
    #    special builtin but NOT for a parse error.)
    # shellcheck disable=SC1091
    if ! ( . .venv/bin/activate ) >/dev/null 2>&1; then
        echo "❌ backend/.venv exists but its activate script could not be sourced."
        echo "   The venv is present but corrupt."
        echo "   Re-create it: 'cd backend && rm -rf .venv && uv sync --extra dev'."
        exit 1
    fi

    # Sourcing is known-good now, so do it for real in this shell.
    # shellcheck disable=SC1091
    . .venv/bin/activate

    # 3. Sourced cleanly but activated nothing. An activate truncated by an
    #    interrupted `uv sync` is still valid shell that sets no PATH, so every
    #    shell sources it happily and returns 0 — a status check alone cannot
    #    see this. Verify the *effect* instead: the tools about to run must come
    #    from the venv, not from whatever sits on the outer PATH.
    venv_bin_dir=$(cd .venv/bin && pwd -P)
    for required_tool in ruff mypy pytest; do
        resolved_tool=$(command -v "${required_tool}" 2>/dev/null)
        resolved_tool_dir=""
        if [ -n "${resolved_tool}" ]; then
            resolved_tool_dir=$(cd "$(dirname "${resolved_tool}")" && pwd -P)
        fi
        if [ "${resolved_tool_dir}" != "${venv_bin_dir}" ]; then
            echo "❌ backend/.venv activated but '${required_tool}' does not resolve inside it."
            echo "   Found:    ${resolved_tool:-<not on PATH>}"
            echo "   Expected: ${venv_bin_dir}/${required_tool}"
            echo "   Checks would run against the wrong environment."
            echo "   Re-create it: 'cd backend && rm -rf .venv && uv sync --extra dev'."
            exit 1
        fi
    done


    echo ">> Running ruff check..."
    if ! ruff check .; then
        echo "❌ ruff check failed! Please fix linting errors."
        exit 1
    fi

    echo ">> Running ruff format --check..."
    if ! ruff format --check .; then
        echo "❌ ruff format failed! Run 'ruff format .' to fix formatting."
        exit 1
    fi

    echo ">> Running mypy..."
    if ! mypy app; then
        echo "❌ mypy failed! Please fix type errors."
        exit 1
    fi

    echo ">> Running pytest..."
    if ! pytest; then
        echo "❌ pytest failed! Please fix failing tests."
        exit 1
    fi
    
    cd ..
fi

# Check if Flutter app files changed
if git diff --cached --name-only | grep -q "^app/"; then
    echo "=> 🐦 Flutter app files modified. Running checks..."

    # Capture the staged paths HERE, while git still resolves this repo. The
    # Flutter section below unsets git's repo-local environment, and the
    # warning above that unset is the whole reason this line is not further
    # down next to the code that consumes it (#440).
    #
    # Deletions are filtered out: a removed test file is not a test target,
    # and a removed source file has no counterpart left to run.
    staged_app_paths=$(git diff --cached --name-only --diff-filter=d | grep '^app/')

    cd app || exit 1

    # Resolve Flutter. FVM symlink wins so the hook always uses the version
    # pinned in app/.fvmrc; system locations are fallbacks for devs not on FVM.
    #
    # app/.fvm/flutter_sdk is gitignored and only materialized by `fvm use`,
    # so linked worktrees don't carry their own copy. Fall back to the main
    # checkout's, resolved via git-common-dir (which always points at the
    # main worktree's .git, in this checkout or any linked one) — see #594.
    main_common_dir=$(git rev-parse --git-common-dir 2>/dev/null)
    main_app_fvm_bin=""
    if [ -n "$main_common_dir" ]; then
        main_checkout_dir=$(cd "$(dirname "$main_common_dir")" && pwd -P 2>/dev/null)
        if [ -n "$main_checkout_dir" ]; then
            main_app_fvm_bin="$main_checkout_dir/app/.fvm/flutter_sdk/bin"
        fi
    fi

    flutter_bin_dir=""
    for flutter_candidate in \
        ".fvm/flutter_sdk/bin" \
        "$main_app_fvm_bin" \
        "$HOME/development/flutter/bin" \
        "$HOME/flutter/bin" \
        "/opt/flutter/bin"; do
        if [ -n "$flutter_candidate" ] && [ -x "$flutter_candidate/flutter" ]; then
            flutter_bin_dir="$flutter_candidate"
            break
        fi
    done

    if [ -z "$flutter_bin_dir" ]; then
        echo "❌ No Flutter SDK found. Checked local app/.fvm/flutter_sdk, the main"
        echo "   checkout's app/.fvm/flutter_sdk, and system locations."
        echo "   Run 'fvm use' (in the main checkout, or in this worktree) and retry."
        exit 1
    fi

    export PATH="$flutter_bin_dir:$PATH"

    # Clear git's repo-local environment variables for the WHOLE Flutter
    # section, before any flutter/dart invocation below.
    #
    # When `git commit` runs this hook from a linked worktree, git exports
    # GIT_DIR/GIT_INDEX_FILE/GIT_PREFIX (and friends) into the hook's own
    # environment, pointing at the committing worktree's git-dir. Every child
    # process inherits them, and git's repo resolution prefers an explicit
    # GIT_DIR over cwd-based discovery — so a `cd` cannot escape them.
    #
    # Both SDK launchers resolve their own identity through git. `flutter`
    # derives the revision it stamps into bin/cache/flutter.version.json from
    # the git repo it resolves; `dart` (bin/internal/shared.sh) validates its
    # tool cache against `git -C "$FLUTTER_ROOT" rev-parse HEAD` and, when that
    # answers with a foreign revision, deletes bin/cache/flutter.version.json
    # and never rewrites it. FLUTTER_ROOT is the *shared* SDK, so one commit
    # from one worktree breaks `dart pub` for every other worker on the
    # machine (#594, #644).
    #
    # Clearing once here — rather than per invocation — is deliberate: it makes
    # every tool call below clean by construction instead of only the ones we
    # remembered to wrap. The corollary is load-bearing for future edits:
    # ANY NEW `git` INVOCATION IN THIS SECTION MUST GO ABOVE THE UNSET BELOW.
    #
    # That list IS the safeguard, so obtaining it is a prerequisite, not a
    # best-effort step. Two conditions, because a status check alone is not
    # sufficient: an empty-but-successful answer leaves the line below a bare
    # `unset` with no operands, which is a silent no-op under sh/bash/dash and
    # a non-fatal error under zsh. Either way nothing is cleared, every
    # invocation below inherits the leaked variables, and the section goes on
    # to corrupt the shared SDK with no diagnostic and a zero exit — the
    # failure mode this whole section exists to prevent. Fail closed instead.
    if ! local_git_env_vars=$(git rev-parse --local-env-vars) ||
        [ -z "$local_git_env_vars" ]; then
        echo "❌ Could not enumerate git's repo-local environment variables."
        echo "   'git rev-parse --local-env-vars' failed or answered with nothing,"
        echo "   so the Flutter checks below cannot be run against a clean git"
        echo "   environment. Running them anyway would corrupt the shared"
        echo "   Flutter SDK for every worktree on this machine (#644)."
        exit 1
    fi
    # Word-splitting is intentional: local_git_env_vars is a newline-separated
    # list of variable names to unset.
    # shellcheck disable=SC2086
    unset $local_git_env_vars

    # Self-heal the Flutter version file before invoking dart. pub locates the
    # SDK via bin/cache/flutter.version.json, but the SDK wrapper deletes that
    # file on a stale tool-cache check and only a `flutter` invocation rewrites
    # it — a bare `dart run` does not. On machines where several workers share
    # one SDK, a sibling's run can knock the file out mid-commit. Touch it here
    # so build_runner always finds the SDK.
    #
    # Run it from *inside* the SDK's own directory, never from app/: flutter
    # derives the identity it stamps into bin/cache/flutter.version.json from
    # the git repo of its cwd. From app/ that repo is Jeeves itself, and
    # flutter will happily write Jeeves's revision into the shared SDK's
    # cache — corrupting it for every other worker on the machine (#594). The
    # subshell exists solely to contain that cd.
    flutter_sdk_root=$(cd "$flutter_bin_dir/.." && pwd -P 2>/dev/null)
    if [ -n "$flutter_sdk_root" ]; then
        (
            cd "$flutter_sdk_root" && flutter --version >/dev/null 2>&1
        )
    fi

    # build_runner is paid on every app/ commit even when nothing it reads has
    # changed. Measured: ~10s warm on a dev Mac, 236s cold on the Pi agent host
    # (833 outputs) — the latter being what a fresh worktree or an SDK bump
    # costs, and well over #440's original ~30s estimate. Skip it when no input
    # is newer than the last successful run. The stamp lives under .dart_tool/,
    # which is gitignored, so it is per-checkout and a fresh worktree always
    # builds rather than trusting a stamp it did not write.
    codegen_stamp=".dart_tool/jeeves-codegen.stamp"
    codegen_needed=yes

    if [ -f "${codegen_stamp}" ]; then
        # Two deliberate choices in the expression below.
        #
        # Generated outputs are EXCLUDED. The stamp is written after the build,
        # so they are normally older than it — but an interrupted build can
        # leave one newer, and counting them would wedge the check into
        # rebuilding on every commit forever.
        #
        # Directories are INCLUDED. A deleted file leaves behind no mtime to
        # notice, but removing it bumps its parent directory — and deletion is
        # exactly the case that must rebuild, because the orphaned .g.dart next
        # to it still declares `part of` a source that is gone, which fails
        # analyze.
        stale_input=$(find lib test \
            \( -type d -o \
               \( -name '*.dart' ! -name '*.g.dart' ! -name '*.freezed.dart' \) \) \
            -newer "${codegen_stamp}" -print 2>/dev/null | head -n 1)

        if [ -z "${stale_input}" ]; then
            stale_input=$(find . -maxdepth 1 \
                \( -name 'pubspec.yaml' -o -name 'pubspec.lock' \) \
                -newer "${codegen_stamp}" -print 2>/dev/null | head -n 1)
        fi

        [ -z "${stale_input}" ] && codegen_needed=no
    fi

    # A stamp is not evidence the outputs are still there. Codegen is
    # gitignored, so `flutter clean`, a prune, or a fresh clone can leave the
    # stamp with nothing beside it — and skipping on that basis hands analyze
    # a tree that cannot compile. Verified by looking for any generated file
    # rather than one named path, so it survives codegen targets coming and
    # going.
    if [ "${codegen_needed}" = no ] &&
        [ -z "$(find lib -name '*.g.dart' -print 2>/dev/null | head -n 1)" ]; then
        codegen_needed=yes
    fi

    if [ "${codegen_needed}" = yes ]; then
        echo ">> Running build_runner..."
        if ! dart run build_runner build --delete-conflicting-outputs; then
            echo "❌ build_runner failed! Please fix code generation errors."
            exit 1
        fi
        mkdir -p .dart_tool && : > "${codegen_stamp}"
    else
        echo ">> build_runner: no codegen input changed since the last run, skipping."
    fi

    echo ">> Running flutter analyze..."
    if ! flutter analyze; then
        echo "❌ flutter analyze failed! Please fix dart warnings/errors."
        exit 1
    fi

    # ----- Test tier ------------------------------------------------------
    # The hook runs the tests covering the staged changes, not the whole
    # suite. A full local pass costs ~7 minutes on the Pi agent host — long
    # enough that a slow run and a hung one are indistinguishable, and long
    # enough to consume an entire agent turn before reaching any real work
    # (#428, #429, both died that way). CI runs the full suite on every PR
    # (.github/workflows/flutter-ci.yml), so that is the enforcement point;
    # this tier exists to catch the obvious break at the moment you make it.
    #
    # The trade-off is deliberate and worth naming: editing a widely-depended
    # -on file runs only ITS test, not its dependents. CI covers the rest.
    # Set JEEVES_FULL_TESTS=1 to run the whole suite locally anyway.
    #
    # Flutter defaults --concurrency to (cores - 2), which on the 4-core agent
    # host is 2. JEEVES_TEST_CONCURRENCY overrides it per host; see
    # docs/TESTING.md § Test tiers.
    concurrency_flag=""
    if [ -n "${JEEVES_TEST_CONCURRENCY:-}" ]; then
        concurrency_flag="--concurrency=${JEEVES_TEST_CONCURRENCY}"
    fi

    test_targets=""
    add_test_target() {
        case " ${test_targets} " in
            *" $1 "*) ;;
            *) test_targets="${test_targets} $1" ;;
        esac
    }

    # Fed by heredoc rather than a pipe so add_test_target's writes survive:
    # a `... | while read` loop runs in a subshell and would discard them.
    while IFS= read -r staged_path; do
        [ -n "${staged_path}" ] || continue
        app_relative_path=${staged_path#app/}
        case "${app_relative_path}" in
            test/*_test.dart)
                [ -f "${app_relative_path}" ] && add_test_target "${app_relative_path}"
                ;;
            lib/*.dart)
                source_basename=$(basename "${app_relative_path}" .dart)
                matched_tests=$(find test -name "${source_basename}_test.dart" \
                    -print 2>/dev/null)
                # Word-splitting is intentional: every candidate is a find
                # match for *_test.dart under app/test, and no Dart source
                # filename in this repo carries a space or a newline.
                # shellcheck disable=SC2086
                for matched_test in ${matched_tests}; do
                    add_test_target "${matched_test}"
                done
                ;;
        esac
    done <<STAGED_PATHS
${staged_app_paths}
STAGED_PATHS

    if [ -n "${JEEVES_FULL_TESTS:-}" ]; then
        echo ">> Running flutter test (full suite — JEEVES_FULL_TESTS is set)..."
        # shellcheck disable=SC2086
        if ! flutter test ${concurrency_flag}; then
            echo "❌ flutter test failed! Please fix failing tests."
            exit 1
        fi
    elif [ -n "${test_targets}" ]; then
        echo ">> Running flutter test on the files covering your staged changes:"
        for selected_test in ${test_targets}; do
            echo "     ${selected_test}"
        done
        # shellcheck disable=SC2086
        if ! flutter test ${concurrency_flag} ${test_targets}; then
            echo "❌ flutter test failed! Please fix failing tests."
            exit 1
        fi
    else
        echo ">> No test file matches the staged changes — skipping flutter test."
        echo "   CI runs the full suite on the PR."
    fi
    
    cd ..
fi

echo "✅ All pre-commit checks passed!"
exit 0
