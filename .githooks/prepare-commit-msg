#!/bin/sh

# prepare-commit-msg hook
# Appends an issue reference from the current branch name to the commit message,
# but ONLY when the branch name carries one in a conventional, anchored shape.

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Guard clause: Exit if the commit has a predefined source other than a regular '-m' message
if [ -n "$COMMIT_SOURCE" ] && [ "$COMMIT_SOURCE" != "message" ]; then
    exit 0
fi

BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null)

# Extract an issue number ONLY from a conventional, anchored branch shape, so a
# stray digit run elsewhere in the name can never be mistaken for one. The old
# pattern matched any '<letters>-<digits>' or bare digit run anywhere, so
# generated branch names appended a wrong reference and permanently linked the
# commit to an unrelated issue: 'review-655' -> '(#review-655)',
# 'coderabbit-review-proxy-3048c7' -> '(#proxy-3048)',
# 'worktree-agent-a0c916b19a98a11ae' -> '(#0)' (#666).
#
# The recognised shapes, tried in order (first match wins):
#   JVS-<number>       a Jira-style key anywhere in the name  (JVS-123)
#   issue-<number>...  a generated worktree branch            (issue-666/slug, issue-304-plan)
#   <type>/<number>... a PR branch, number right after the /  (fix/605-slug, feat/584-slug)
#   <number>-<slug>    a bare leading issue number            (123-add-login)
#
# Anything else — review-655, coderabbit-review-proxy-3048c7,
# worktree-agent-<hex>, main — matches none of these and appends nothing.
ISSUE_ID=$(printf '%s' "$BRANCH_NAME" | grep -oiE '(^|[^a-z0-9])JVS-[0-9]+' | grep -oE '[0-9]+' | head -n 1)
if [ -z "$ISSUE_ID" ]; then
    ISSUE_ID=$(printf '%s' "$BRANCH_NAME" | grep -oE '^issue-[0-9]+' | grep -oE '[0-9]+' | head -n 1)
fi
if [ -z "$ISSUE_ID" ]; then
    ISSUE_ID=$(printf '%s' "$BRANCH_NAME" | grep -oE '^[^/]+/[0-9]+' | grep -oE '[0-9]+' | head -n 1)
fi
if [ -z "$ISSUE_ID" ]; then
    ISSUE_ID=$(printf '%s' "$BRANCH_NAME" | grep -oE '^[0-9]+' | head -n 1)
fi

# Guard clause: Exit if no issue ID found in branch name
if [ -z "$ISSUE_ID" ]; then
    exit 0
fi

# Guard clause: Exit if the commit message already references this issue. Match
# the whole reference token '#<id>' at a digit boundary, NOT a bare substring:
# the old substring test skipped the append whenever the id turned up anywhere
# in the message — routinely for a degenerate '0', but also when a real id
# happened to sit inside a longer number in the body (#666).
if grep -qE "#$ISSUE_ID([^0-9]|$)" "$COMMIT_MSG_FILE"; then
    exit 0
fi

# Append the issue ID to the end of the first line
# Using temporary file for safety across sed implementations
TMP_FILE=$(mktemp)

# Extract first line, append issue ID
FIRST_LINE=$(head -n 1 "$COMMIT_MSG_FILE")
echo "$FIRST_LINE (#$ISSUE_ID)" > "$TMP_FILE"

# Append the rest of the file
tail -n +2 "$COMMIT_MSG_FILE" >> "$TMP_FILE"

mv "$TMP_FILE" "$COMMIT_MSG_FILE"
