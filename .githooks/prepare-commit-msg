#!/bin/sh

# prepare-commit-msg hook
#
# Appends an issue reference from the current branch name on the `-m`/`-F`
# path, where git hands over a subject before any editor opens. The EDITOR
# path — a plain `git commit` — has no subject yet when this hook runs, so it
# is handled by commit-msg, which fires after the editor closes. Both hooks
# share the branch-name contract in .githooks/lib/issue-reference.sh (#679).

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Snapshot the pristine template for commit-msg's untouched-template guard. git
# hands THIS hook $COMMIT_SOURCE=template for every template spelling — the
# `commit.template` config, `git commit --template=<f>`, `-t <f>`, and a CLI
# template overriding a config one — and at this moment the file holds exactly
# that template, before any editor opens. commit-msg receives none of those
# signals (not the CLI path, and `git config commit.template` still reports the
# config value even when --template overrode it), so it reads this snapshot
# instead. It is rewritten on EVERY invocation — the template content on a
# template commit, removed otherwise — so commit-msg always sees a snapshot from
# THIS commit and never a stale one left by an earlier `--no-verify` run (which
# skips commit-msg but not this hook).
pristine=$(git rev-parse --git-path COMMIT_TEMPLATE_PRISTINE 2>/dev/null)
if [ -n "$pristine" ]; then
    if [ "$COMMIT_SOURCE" = "template" ]; then
        cat "$COMMIT_MSG_FILE" > "$pristine" 2>/dev/null || rm -f "$pristine"
    else
        rm -f "$pristine"
    fi
fi

# Guard clause: only ever append to a message git already has in hand.
#
# $COMMIT_SOURCE is "message" for `-m`/`-F`, one of "template"/"merge"/
# "squash"/"commit" when git supplied the text itself, and EMPTY on a plain
# `git commit` — the editor path.
#
# The empty case is the one that matters. This hook runs BEFORE the editor
# opens, so there is nothing to append to yet: the file holds only git's
# comment block, and line 1 is blank. Writing there fills a file git would
# otherwise see as empty, so quitting the editor without saving records a
# commit whose subject is ` (#NNN)` instead of aborting. Quit-to-cancel is the
# standard way to call off a commit; it must keep working. The reference the
# editor path is owed is added later, by commit-msg, once a real subject exists.
#
# Testing $COMMIT_SOURCE rather than inspecting the file is what makes that
# exact. An "is there a message yet?" heuristic has to tell git's comment block
# apart from message text, which means knowing the comment character — and
# under `core.commentChar` or `core.commentString` it is not `#`, so such a
# heuristic reads git's own template as a subject and the abort fails open.
if [ "$COMMIT_SOURCE" != "message" ]; then
    exit 0
fi

# Locate the shared contract. A `.git/hooks/* -> ../../.githooks/*` symlink
# layout runs this file with $0 in .git/hooks, where lib/ does not exist, so
# `dirname "$0"` alone is not enough — fall back to git's own path resolution.
# First readable candidate wins.
lib=""
for candidate in \
    "$( unset CDPATH; cd -- "$(dirname -- "$0")" 2>/dev/null && pwd )/lib/issue-reference.sh" \
    "$(git rev-parse --git-path hooks 2>/dev/null)/lib/issue-reference.sh" \
    "$(git rev-parse --show-toplevel 2>/dev/null)/.githooks/lib/issue-reference.sh"; do
    if [ -r "$candidate" ]; then
        lib=$candidate
        break
    fi
done

# Guard clause: degrade to a silent no-op if the lib is missing. This must come
# BEFORE the `.` below: `.` is a POSIX special builtin, so a failed source
# aborts the script under sh/dash and git then rejects the commit (the #539
# asymmetry). Bailing here keeps a missing lib from blocking commits entirely.
if [ -z "$lib" ]; then
    echo "prepare-commit-msg: shared issue-reference lib not found; skipping issue reference" >&2
    exit 0
fi

# shellcheck source=.githooks/lib/issue-reference.sh
. "$lib"

# The append is best-effort: exit 0 regardless of its status, so a failed write
# inside append_issue_reference (e.g. a failed mv) can never reject the commit.
append_issue_reference "$COMMIT_MSG_FILE"
exit 0
